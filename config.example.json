{
  "dryRun": true,
  "resumes": [
    {
      "id": "react",
      "title": "Frontend-разработчик (React, Next.js, TypeScript)",
      "match": [
        "react",
        "next.js",
        "nextjs",
        "redux",
        "mobx",
        "react native"
      ],
      "exclude": [],
      "file": "resume.react.md"
    },
    {
      "id": "vue",
      "title": "Frontend-разработчик (Vue.js, Nuxt, TypeScript)",
      "match": [
        "vue",
        "vue.js",
        "vuejs",
        "nuxt",
        "vuex",
        "pinia"
      ],
      "exclude": [],
      "file": "resume.vue.md"
    }
  ],
  "routing": {
    "fallbackResumeId": "react",
    "titleWeight": 5,
    "minScore": 1
  },
  "search": {
    "text": "frontend OR фронтенд OR react OR vue OR angular OR javascript OR typescript OR верстальщик OR fullstack OR фулстек OR node.js",
    "searchField": [
      "name"
    ],
    "area": [],
    "excludedText": [],
    "workFormat": [],
    "period": 30,
    "maxPages": 20
  },
  "filters": {
    "skipWithTest": false,
    "companyBlacklist": [],
    "titleBlacklist": []
  },
  "limits": {
    "perDay": 100,
    "perHour": 100,
    "delayMs": 5000,
    "delayJitterMs": 400,
    "readPauseMsMin": 1500,
    "readPauseMsMax": 4000
  },
  "scoring": {
    "weights": {
      "vacancy": 0.3,
      "cvMatch": 0.5,
      "overall": 0.2
    },
    "threshold": 65,
    "requiredKeywordHits": 1,
    "keywords": [
      "frontend",
      "front-end",
      "front end",
      "фронтенд",
      "фронт",
      "react",
      "vue",
      "angular",
      "svelte",
      "next",
      "nuxt",
      "javascript",
      "typescript",
      "js",
      "ts",
      "верстальщик",
      "вёрстка",
      "верстка",
      "ui",
      "fullstack",
      "full-stack",
      "full stack",
      "фулстек",
      "фуллстек",
      "фулстак",
      "node",
      "node.js",
      "nodejs",
      "nest",
      "nest.js",
      "nestjs"
    ]
  },
  "letter": {
    "mode": "static",
    "text": "Здравствуйте! Работал со всеми технологиями из вашей вакансии. Когда удобно созвониться?",
    "maxChars": 1000,
    "minChars": 300,
    "requireManualApproval": false,
    "language": "ru",
    "salaryByGrade": {
      "junior": 150000,
      "middle": 200000,
      "senior": 250000
    },
    "noLinksExcuse": "Весь код рабочий и закрыт NDA, поэтому публичных репозиториев нет. Готов разобрать любой свой проект на созвоне или выполнить тестовое.",
    "batchSize": 10,
    "extraSkills": ""
  },
  "llm": {
    "provider": "claude-cli",
    "model": "sonnet",
    "apiKeyEnv": "LLM_API_KEY",
    "maxConcurrency": 1,
    "timeoutSec": 120
  },
  "browser": {
    "headless": false,
    "locale": "ru-RU",
    "timezone": "Europe/Moscow",
    "manualActionTimeoutMs": 300000,
    "slowMoMs": 0
  }
}
