{
  "name": "head-hunter-hunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "login": "tsx src/cli.ts login",
    "doctor": "tsx src/cli.ts doctor",
    "selectors:probe": "tsx src/cli.ts probe",
    "server": "tsx watch src/server/index.ts",
    "ui": "vite --config ui/vite.config.ts",
    "dev": "npm-run-all --parallel server ui",
    "typecheck": "tsc --noEmit",
    "review": "tsx src/cli.ts review",
    "resolve": "tsx src/cli.ts resolve",
    "collect": "tsx src/cli.ts collect",
    "apply": "tsx src/cli.ts apply",
    "failures": "tsx src/cli.ts failures",
    "requeue": "tsx src/cli.ts requeue"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "better-sqlite3": "^11.7.0",
    "fastify": "^5.2.0",
    "playwright": "^1.49.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "npm-run-all": "^4.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
